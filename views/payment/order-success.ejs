    <style type="text/css">
        body,
        table,
        td,
        a {
            -webkit-text-size-adjust: 100%;
            -ms-text-size-adjust: 100%;
        }

        table,
        td {
            mso-table-lspace: 0pt;
            mso-table-rspace: 0pt;
        }

        img {
            -ms-interpolation-mode: bicubic;
        }

        img {
            border: 0;
            height: auto;
            line-height: 100%;
            outline: none;
            text-decoration: none;
        }

        table {
            border-collapse: collapse !important;
        }

        body {
            height: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
            width: 100% !important;
            background: #f4f8fb;
        }

        a[x-apple-data-detectors] {
            color: inherit !important;
            text-decoration: none !important;
            font-size: inherit !important;
            font-family: inherit !important;
            font-weight: inherit !important;
            line-height: inherit !important;
        }

        .order-confirm-card {
            background: #ffffff;
            border: 1px solid #e6eef6;
            border-radius: 28px;
            box-shadow: 0 22px 55px rgba(23, 54, 93, 0.08);
            padding: 50px 32px;
            margin: 50px 0;
        }

        .order-confirm-inner {
            background: #fcfeff;
            border-radius: 22px;
            padding: 42px 30px;
            max-width: 660px;
            margin: 0 auto;
            border: 1px solid rgba(0, 0, 0, 0.04);
        }

        .order-status-icon {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: #e6f7ea;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 28px;
        }

        .order-status-icon i {
            font-size: 56px;
            color: #1cab51;
        }

        .order-confirm-title {
            font-size: 30px;
            font-weight: 500;
            color: #1f7137;
            margin: 0 0 14px;
        }

        .order-confirm-subtitle {
            font-size: 16px;
            color: #6e7b89;
            margin: 0 0 28px;
            max-width: 560px;
            margin-left: auto;
            margin-right: auto;
            line-height: 1.7;
        }

        .order-info-row {
            display: flex;
            justify-content: center;
            gap: 18px;
            flex-wrap: wrap;
            margin: 18px 0 34px;
        }

        .order-info-card {
            background: #ffffff;
            border: 1px solid #e9f2f7;
            border-radius: 16px;
            padding: 18px 22px;
            min-width: 180px;
            text-align: left;
        }

        .order-info-card strong {
            display: block;
            font-size: 13px;
            font-weight: 700;
            color: #4c5d70;
            margin-bottom: 8px;
            text-transform: uppercase;
            letter-spacing: 0.04em;
        }

        .order-info-card span {
            display: block;
            font-size: 15px;
            color: #1b2832;
        }

        .order-action-row {
            display: flex;
            justify-content: center;
            gap: 16px;
            flex-wrap: wrap;
            margin-top: 24px;
        }

        .order-action-row a {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 180px;
            padding: 14px 32px;
            border-radius: 999px;
            font-size: 16px;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .btn-order-primary {
            color: #ffffff;
            background: #23a14d;
            border: 1px solid #23a14d;
        }

        .btn-order-primary:hover {
            background: #1f9146;
            border-color: #1f9146;
        }

        .btn-order-secondary {
            color: #1f4b67;
            background: #f8fcff;
            border: 1px solid #d7e7f0;
        }

        .btn-order-secondary:hover {
            background: #ebf5fb;
        }

        .product-preview {
            display: flex;
            justify-content: center;
            gap: 18px;
            flex-wrap: wrap;
            margin: 28px 0 0;
        }

        .product-thumb {
            width: 130px;
            border-radius: 18px;
            overflow: hidden;
            border: 1px solid #e8eef2;
            background: #ffffff;
            box-shadow: 0 16px 40px rgba(39, 84, 140, 0.08);
        }

        .product-thumb img {
            width: 100%;
            display: block;
        }

        .product-thumb p {
            margin: 10px;
            font-size: 13px;
            line-height: 1.4;
            color: #5d6c7f;
            text-align: center;
        }

        @media screen and (max-width: 575px) {
            .order-confirm-card {
                padding: 34px 18px;
            }

            .order-confirm-inner {
                padding: 28px 20px;
            }

            .order-info-card {
                width: 100%;
                min-width: unset;
            }

            .product-thumb {
                width: calc(50% - 9px);
            }
        }

        @media screen and (max-width: 420px) {
            .product-thumb {
                width: 100%;
            }
        }

        @media screen and (max-width: 480px) {
            .mobile-hide {
                display: none !important;
            }

            .mobile-center {
                text-align: center !important;
            }
        }

        div[style*="margin: 16px 0;"] {
            margin: 0 !important;
        }
        
    </style>
</head>
    <body class="cnt-home">
        <% if (typeof txnid !== 'undefined' && typeof amount !== 'undefined' && typeof getrows !== 'undefined' && getrows && getrows.length > 0) { %>
        <script>
            (function () {
                var transactionId = <%- JSON.stringify(txnid) %>;
                var storageKey = 'ga4_purchase_' + transactionId;

                if (window.gtag && !sessionStorage.getItem(storageKey)) {
                    var purchaseItems = <%- JSON.stringify(getrows.map(function (item) {
                        var price = Number(item.price) || 0;
                        var discount = Number(item.discount) || 0;
                        var quantity = Number(item.cartquantity) || 1;
                        var discountedPrice = price - ((price / 100) * discount);

                        return {
                            item_id: String(item.product_id || ''),
                            item_name: item.name || '',
                            price: Number(discountedPrice.toFixed(2)),
                            quantity: quantity
                        };
                    })) %>;

                    gtag('event', 'purchase', {
                        transaction_id: transactionId,
                        value: Number(<%- JSON.stringify(amount) %>) || 0,
                        currency: 'INR',
                        items: purchaseItems
                    });

                    sessionStorage.setItem(storageKey, '1');
                }
            })();
        </script>
        <% } %>
        <header class="header-style-1">
            <%- include("../front/top_bar") -%>
            <%- include("../front/search") -%>
