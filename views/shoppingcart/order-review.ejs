<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no" />
    <meta name="robots" content="INDEX,FOLLOW" />
    <title>Sriina | Review Your Order</title>
    <link rel="stylesheet" href="<%= baseURL %>assets/css/bootstrap.min.css" />
    <link rel="stylesheet" href="<%= baseURL %>assets/css/main.css" />
    <link rel="stylesheet" href="<%= baseURL %>assets/css/blue.css" />
    <link rel="stylesheet" href="<%= baseURL %>assets/css/owl.carousel.css" />
    <link rel="stylesheet" href="<%= baseURL %>assets/css/owl.transitions.css" />
    <link rel="stylesheet" href="<%= baseURL %>assets/css/animate.min.css" />
    <link rel="stylesheet" href="<%= baseURL %>assets/css/rateit.css" />
    <link rel="stylesheet" href="<%= baseURL %>assets/css/bootstrap-select.min.css" />
    <link href="<%= baseURL %>assets/css/custom.css" rel="stylesheet" />
    <link rel="stylesheet" href="<%= baseURL %>assets/css/font-awesome.css" />
    <link href="http://fonts.googleapis.com/css?family=Roboto:300,400,500,700" rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:400,300,400italic,600,600italic,700,700italic,800"
        rel="stylesheet" type="text/css" />
    <link href="https://fonts.googleapis.com/css?family=Montserrat:400,700" rel="stylesheet" type="text/css" />
    <style>
        .review-thumb {
            width: 60px;
            height: 60px;
            object-fit: cover;
            border: 1px solid #eee;
        }

        .review-summary-box {
            border: 1px solid #e5e5e5;
            border-radius: 4px;
        }

        .review-summary-box .panel-heading {
            background: #f5f5f5;
            padding: 12px 15px;
        }

        .review-summary-box .unicase-checkout-title {
            margin: 0;
            padding: 0;
            font-size: 16px;
            font-weight: 700;
            line-height: 1.4;
            text-align: left;
            text-transform: none;
        }

        .review-total-row td {
            font-weight: 800;
            border-top: 2px solid #eee;
        }

        .review-address-card {
            border: 1px solid #e5e5e5;
            border-radius: 4px;
            padding: 15px;
        }

        .payment-badge {
            display: inline-block;
            padding: 6px 12px;
            background: #eef7ee;
            color: #2e7d32;
            border-radius: 4px;
            font-weight: 600;
        }
    </style>
</head>

<body class="cnt-home">
    <header class="header-style-1">
        <%- include("../front/top_bar") -%>
            <%- include("../front/search") -%>
                <%- include("../front/navigation") -%>
    </header>

    <div class="breadcrumb">
        <div class="container">
            <div class="breadcrumb-inner">
                <ul class="list-inline list-unstyled">
                    <li><a href="/">Home</a></li>
                    <li><a href="/checkout">Checkout</a></li>
                    <li class="active">Review Order</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="body-content">
        <div class="container">
            <div class="checkout-box">
                <h3 style="margin-top:0;">Review your order</h3>
                <p class="text-muted">Please review the details below before placing your order.</p>
                <div class="row">
                    <div class="col-md-8">
                        <!-- Items -->
                        <div class="panel panel-default review-summary-box">
                            <div class="panel-heading">
                                <h4 class="unicase-checkout-title" style="margin:0;">Items in your order</h4>
                            </div>
                            <div class="panel-body" style="padding:0;">
                                <table class="table" style="margin:0;">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Product</th>
                                            <th class="text-center">Qty</th>
                                            <th class="text-right">Price</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% items.forEach((list, index)=> { %>
                                            <% let unitPrice=(list.productType==2) ? Number(list.groceyProductPrice ||
                                                0) : Number(list.price || 0); let unitDiscount=(list.productType==2) ?
                                                Number(list.unitDiscount || 0) : Number(list.discount || 0); let
                                                lineBase=unitPrice * Number(list.cartquantity || 0); let
                                                lineTotal=lineBase - ((lineBase / 100) * unitDiscount); %>
                                                <tr>
                                                    <td>
                                                        <%= index + 1 %>
                                                    </td>
                                                    <td>
                                                        <div style="display:flex; align-items:center;">
                                                            <% if (list.productType==2) { %>
                                                                <img class="review-thumb"
                                                                    src="<%= baseURL %>/admin/grocery/images/<%= list.groceyImg %>"
                                                                    alt="" />
                                                                <% } else if (/(http(s?)):\/\//i.test(list.image)) { %>
                                                                    <img class="review-thumb" src="<%= list.image %>"
                                                                        alt="" />
                                                                    <% } else { %>
                                                                        <img class="review-thumb"
                                                                            src="<%= process.env.IMAGE_URL %><%= list.image %>"
                                                                            alt="" />
                                                                        <% } %>
                                                                            <span style="margin-left:12px;">
                                                                                <%= list.name %>
                                                                            </span>
                                                        </div>
                                                    </td>
                                                    <td class="text-center">
                                                        <%= list.cartquantity %>
                                                    </td>
                                                    <td class="text-right">&#8377;<%=
                                                            lineTotal.toFixed(2).replace(/(\d)(?=(\d\d\d)+(?!\d))/g, "$1,"
                                                            ) %>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Delivery address -->
                        <div class="panel panel-default review-summary-box">
                            <div class="panel-heading">
                                <h4 class="unicase-checkout-title" style="margin:0;">Delivery Address</h4>
                            </div>
                            <div class="panel-body">
                                <% if (delivery_address) { %>
                                    <div class="review-address-card">
                                        <strong>
                                            <%= delivery_address.fullname %>
                                        </strong> (<%= delivery_address.mobile %>)<br />
                                            <%= delivery_address.house_address %>, <%= delivery_address.colony_area %>
                                                    <br />
                                                    <%= delivery_address.city_town %>, <%= delivery_address.StateName %>
                                                            <br />
                                                            <%= delivery_address.CountryName %> - PIN: <%=
                                                                    delivery_address.pincode %>
                                    </div>
                                    <% } else { %>
                                        <p class="text-danger">No shipping address selected. <a href="/checkout">Go back
                                                to add / select an address</a>.</p>
                                        <% } %>
                            </div>
                        </div>

                        <!-- Payment method -->
                        <div class="panel panel-default review-summary-box">
                            <div class="panel-heading">
                                <h4 class="unicase-checkout-title" style="margin:0;">Payment Method</h4>
                            </div>
                            <div class="panel-body">
                                <% if (payment_method==2) { %>
                                    <span class="payment-badge"><i class="fa fa-money" aria-hidden="true"></i> Cash on
                                        Delivery</span>
                                    <% } else { %>
                                        <span class="payment-badge">Online Payment</span>
                                        <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Summary sidebar -->
                    <div class="col-md-4">
                        <div class="checkout-progress-sidebar">
                            <div class="panel panel-default review-summary-box">
                                <div class="panel-heading">
                                    <h4 class="unicase-checkout-title" style="margin:0; padding:8px;">Order Summary
                                    </h4>
                                </div>
                                <div class="panel-body">
                                    <table class="table" style="margin:0;">
                                        <tr>
                                            <td>Items Total</td>
                                            <td class="text-right">&#8377;<%= (subtotal -
                                                    delivery_charge).toFixed(2).replace(/(\d)(?=(\d\d\d)+(?!\d))/g, "$1,"
                                                    ) %>
                                            </td>
                                        </tr>
                                        <tr class="review-total-row">
                                            <td>Total Payable</td>
                                            <td class="text-right">&#8377;<%=
                                                    subtotal.toFixed(2).replace(/(\d)(?=(\d\d\d)+(?!\d))/g, "$1," ) %>
                                            </td>
                                        </tr>
                                    </table>

                                    <form method="POST" action="/confim_order" style="margin-top:15px;">
                                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                        <input type="hidden" name="txnid" value="<%= encTxnid %>">
                                        <input type="hidden" name="cartId" value="<%= encCartId %>">
                                        <input type="hidden" name="paid_amount" value="<%= encPaidAmount %>">
                                        <input type="hidden" name="payment_method" value="<%= payment_method %>">
                                        <input type="hidden" name="shipping_address" value="<%= shippingId %>">
                                        <button type="submit" class="btn btn-primary btn-block">
                                            Place Order &#8377;<%=
                                                subtotal.toFixed(2).replace(/(\d)(?=(\d\d\d)+(?!\d))/g, "$1," ) %>
                                        </button>
                                    </form>
                                    <a href="/addtocart" class="btn btn-default btn-block" style="margin-top:8px;">Back
                                        to Cart</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <% include ("../front/book_footer") %>
        <script src="assets/js/jquery-1.11.1.min.js"></script>
        <script src="assets/js/bootstrap.min.js"></script>
        <script src="assets/js/bootstrap-hover-dropdown.min.js"></script>
        <script src="assets/js/owl.carousel.min.js"></script>
        <script src="assets/js/echo.min.js"></script>
        <script src="assets/js/jquery.easing-1.3.min.js"></script>
        <script src="assets/js/bootstrap-slider.min.js"></script>
        <script src="assets/js/jquery.rateit.min.js"></script>
        <script type="text/javascript" src="assets/js/lightbox.min.js"></script>
        <script src="assets/js/bootstrap-select.min.js"></script>
        <script src="assets/js/wow.min.js"></script>
        <script src="assets/js/scripts.js"></script>
</body>

</html>